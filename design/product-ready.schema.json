{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Product export with known price; not a verified production CDP schema",
  "description": "All 13 keys required. Unpriced discovery/group records stay in staging or a separate discovery view. JSON Schema cannot enforce foreign keys, currency minor units or quote freshness; enforce those in publication code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["productId", "name", "taxonomy", "destination", "description", "attributes", "unitPrice", "currency", "available", "sourceRef", "imageUrl", "availableFrom", "availableTo"],
  "properties": {
    "productId": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "taxonomy": {"enum": ["hotel", "flight", "attraction", "combo", "golf"]},
    "destination": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "attributes": {
      "type": "object",
      "properties": {
        "parentProductId": {"type": ["string", "null"], "format": "uuid"},
        "bookable": {"type": "boolean"},
        "availabilityStatus": {"enum": ["available", "unavailable", "unknown", "stale"]},
        "priceKind": {"enum": ["quote", "from", "reference", "free"]},
        "priceObservedAt": {"type": ["string", "null"], "format": "date-time"},
        "bookingUrl": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": true
    },
    "unitPrice": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "available": {"type": "boolean"},
    "sourceRef": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "imageUrl": {"type": ["string", "null"], "format": "uri"},
    "availableFrom": {"type": ["string", "null"], "format": "date"},
    "availableTo": {"type": ["string", "null"], "format": "date"}
  }
}
